{
  "name": "vscode-ldf-explorer",
  "displayName": "LDF Explorer",
  "version": "0.2.0",
  "description": "VS Code extension for exploring and editing LIN Description Files (LDF)",
  "main": "./dist/extension.js",
  "bin": {
    "ldf-explorer": "./dist/cli/index.js"
  },
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "LDF",
    "LIN",
    "automotive",
    "embedded"
  ],
  "activationEvents": [
    "onCommand:ldfExplorer.openLdf",
    "onLanguage:ldf"
  ],
  "contributes": {
    "commands": [
      {
        "command": "ldfExplorer.openLdf",
        "title": "Open in LDF Explorer",
        "category": "LDF Explorer",
        "icon": "$(open-preview)"
      },
      {
        "command": "ldfExplorer.checkUpdate",
        "title": "Check for Updates",
        "category": "LDF Explorer"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "ldfExplorer.openLdf",
          "when": "resourceExtname == .ldf"
        },
        {
          "command": "ldfExplorer.checkUpdate",
          "when": "true"
        }
      ],
      "editor/title": [
        {
          "command": "ldfExplorer.openLdf",
          "when": "resourceExtname == .ldf",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "ldfExplorer.openLdf",
          "when": "resourceExtname == .ldf",
          "group": "navigation"
        }
      ]
    },
    "languages": [
      {
        "id": "ldf",
        "aliases": [
          "LIN Description File",
          "LDF"
        ],
        "extensions": [
          ".ldf"
        ]
      }
    ],
    "configuration": {
      "title": "LDF Explorer",
      "properties": {
        "ldfExplorer.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Python executable path for running ldfparser. Only used when the bundled bridge executable is not available."
        },
        "ldfExplorer.autoCheckUpdate": {
          "type": "boolean",
          "default": true,
          "description": "Automatically check for updates when the extension activates."
        },
        "ldfExplorer.githubToken": {
          "type": "string",
          "default": "",
          "description": "GitHub Personal Access Token for accessing private release repositories. Not required for public repositories."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "build:webview": "cd webview && npm run build",
    "build": "npm run compile && npm run build:webview",
    "lint": "echo \"No lint configured\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build:bridge": "cd python && pyinstaller --distpath ../bin build_exe.spec",
    "build:bridge:clean": "cd python && pyinstaller --clean --distpath ../bin build_exe.spec"
  },
  "author": "",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/notdog1998/FV_LDF_Parser.git"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "@types/semver": "^7.7.1",
    "@types/vscode": "^1.105.0",
    "@vitest/coverage-v8": "^4.1.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "semver": "^7.8.5"
  }
}
